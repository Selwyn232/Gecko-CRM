# Kopieer naar .env en vul in. .env wordt nooit gecommit.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gecko:gecko@localhost:5432/gecko
# 32 bytes, base64. Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Sessieduur
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
APP_NAME=Gecko CRM
